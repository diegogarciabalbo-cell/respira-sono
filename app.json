{
  "expo": {
    "name": "RESPIRA Sono",
    "slug": "respira-sono",
    "version": "0.1.0",
    "scheme": "respirasono",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.respirasono.dev",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "NSMicrophoneUsageDescription": "O RESPIRA Sono usa o microfone para gravar o áudio da sua noite. A gravação fica no seu aparelho.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "pt-BR",
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "app.respirasono.dev",
      "adaptiveIcon": {
        "backgroundColor": "#E8EFF8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.WAKE_LOCK"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "allowBackup": false,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "O RESPIRA Sono usa o microfone para gravar o áudio da sua noite. A gravação fica no seu aparelho.",
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "locales": {
      "pt-BR": "./locales/ios/pt-BR.json",
      "en": "./locales/ios/en.json",
      "es": "./locales/ios/es.json",
      "zh-Hans": "./locales/ios/zh-Hans.json"
    },
    "owner": "diegobalbo",
    "extra": {
      "eas": {
        "projectId": "64885af7-33ca-4a63-b176-cde72f25d6e9"
      }
    }
  }
}
